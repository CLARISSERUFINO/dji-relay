# drone_logger configuration.
#
# drone_logger runs inside ssl-aggregator and reads the same `.env` file as
# robot_logger and vision_logger. Add these keys to ssl-aggregator's
# `.env.example` / `.env`. The shared keys (DB_CONNINFO, PGPASSWORD,
# DB_BATCH_SIZE, DB_MAX_LATENCY_MS) and the robot/vision multicast keys
# (ROBOT_MCAST_*, VISION_MCAST_*) are already defined there and are not repeated.
# Real environment variables override these values.

# --- Network -----------------------------------------------------------------
# Unicast ports the phone sends to
# DRONE_VIDEO_PORT=5600
# DRONE_META_PORT=5601
# Local address to bind (0.0.0.0 = all interfaces)
# DRONE_BIND_ADDR=0.0.0.0

# --- Output --------------------------------------------------------------------
# A folder <capture_session>/ is created here for video_live.mkv and session.json
DRONE_OUTPUT_DIR=~/drone-sessions
# 1 = also write rtp_packets.csv (one row per RTP packet), for experiments E1-E5
# DRONE_PACKET_LOG=0

# --- SSL-Vision injection (v4l2loopback virtual camera) ----------------------------
# 1 = write decoded frames to the virtual camera that SSL-Vision reads
# DRONE_INJECT=1
# Must match the v4l2loopback video_nr and SSL-Vision's "cam idx"
# DRONE_V4L2_DEVICE=/dev/video10

# --- vision_logger (existing logger, new key) --------------------------------------
# Tag written to the new `source` column: live, or replay:<file> when replaying a 4K MP4
# VISION_SOURCE=live

# --- Video pipeline --------------------------------------------------------------
# DRONE_JITTER_LATENCY_MS=30
# 1 = show the live video in a window, 0 = record only
# DRONE_SHOW_VIDEO=1
# nvh264dec (RTX hardware) or avdec_h264 (software fallback)
# DRONE_DECODER=nvh264dec

# --- Expected configuration (checked against what the phone reports) -------------
# Live stream
# DRONE_EXPECT_LIVE_MIME=H264
# DRONE_EXPECT_LIVE_WIDTH=1920
# DRONE_EXPECT_LIVE_HEIGHT=1080
# DRONE_EXPECT_LIVE_FPS=30
# microSD recording
# DRONE_EXPECT_REC_CODEC=H265
# DRONE_EXPECT_REC_RESOLUTION=RESOLUTION_3840x2160
# Comma-separated list of accepted VideoFrameRate values
# DRONE_EXPECT_REC_FRAMERATE=RATE_60FPS,RATE_59FPS,RATE_PRECISE_60FPS
# DRONE_EXPECT_EXPOSURE_MODE=MANUAL
# DRONE_EXPECT_AIRLINK_BAND=BAND_5_DOT_8G
# Leave blank to skip a check
DRONE_EXPECT_ISO=
DRONE_EXPECT_SHUTTER=
# DRONE_EXPECT_WB_KELVIN=5500
DRONE_EXPECT_COLOR=
# DRONE_EXPECT_SUBTITLES=1
